{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarot KB card (RWS, tiếng Việt)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "ten_vi", "ten_en", "arcana", "so", "chat", "hoang_gia",
    "bieu_tuong", "cot_loi", "tu_khoa_xuoi", "tu_khoa_nguoc", "canh_bao",
    "nguyen_to", "chiem_tinh_gd", "chiem_tinh_hd",
    "sac_thai", "lang_kinh", "cach_noi_viet"
  ],
  "properties": {
    "id":        {"type": "string", "pattern": "^(major_(0[0-9]|1[0-9]|2[01])|(wand|cup|sword|coin)_(0[1-9]|10|page|knight|queen|king))$"},
    "ten_vi":    {"type": "string", "minLength": 1},
    "ten_en":    {"type": "string", "minLength": 1},
    "arcana":    {"enum": ["chinh", "phu"]},
    "so":        {"type": ["integer", "null"], "minimum": 0, "maximum": 21},
    "chat":      {"enum": ["gay", "cup", "kiem", "tien", null]},
    "hoang_gia": {"type": "boolean"},

    "bieu_tuong":    {"type": "array", "minItems": 5, "maxItems": 8, "items": {"type": "string", "minLength": 8}},
    "cot_loi":       {"type": "string", "minLength": 20},
    "tu_khoa_xuoi":  {"type": "array", "minItems": 5, "maxItems": 8, "items": {"type": "string", "minLength": 2}},
    "tu_khoa_nguoc": {"type": "array", "minItems": 5, "maxItems": 8, "items": {"type": "string", "minLength": 2}},
    "canh_bao":      {"type": "string", "minLength": 20},

    "nguyen_to":     {"enum": ["hoa", "thuy", "khi", "tho"]},
    "chiem_tinh_gd": {"type": "string", "minLength": 1},
    "chiem_tinh_hd": {"type": ["string", "null"]},

    "sac_thai": {
      "type": "object", "additionalProperties": false,
      "required": ["trong_luong", "dong_tinh", "huong"],
      "properties": {
        "trong_luong": {"enum": ["rất nhẹ", "nhẹ", "vừa", "nặng", "rất nặng"]},
        "dong_tinh":   {"enum": ["tĩnh", "động vừa", "động mạnh", "động đột ngột"]},
        "huong":       {"type": "string", "minLength": 2, "maxLength": 60}
      }
    },

    "lang_kinh": {
      "type": "object", "additionalProperties": false,
      "required": ["tinh_cam", "cong_viec", "tien_bac", "tam_ly", "hoc_hanh"],
      "properties": {
        "tinh_cam":  {"type": "string", "minLength": 15},
        "cong_viec": {"type": "string", "minLength": 15},
        "tien_bac":  {"type": "string", "minLength": 15},
        "tam_ly":    {"type": "string", "minLength": 15},
        "hoc_hanh":  {"type": "string", "minLength": 15}
      }
    },

    "cach_noi_viet": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string", "minLength": 3}},

    "ba_cach_doc": {
      "type": "object", "additionalProperties": false,
      "required": ["la_nguoi", "la_nang_luong", "la_tinh_huong"],
      "properties": {
        "la_nguoi":      {"type": "string", "minLength": 30},
        "la_nang_luong": {"type": "string", "minLength": 30},
        "la_tinh_huong": {"type": "string", "minLength": 30}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"hoang_gia": {"const": true}}}, "then": {"required": ["ba_cach_doc"]}},
    {"if": {"properties": {"hoang_gia": {"const": false}}}, "then": {"not": {"required": ["ba_cach_doc"]}}},
    {"if": {"properties": {"arcana": {"const": "chinh"}}}, "then": {"properties": {"chat": {"const": null}, "so": {"type": "integer"}}}},
    {"if": {"properties": {"arcana": {"const": "phu"}}}, "then": {"properties": {"chat": {"type": "string"}}}}
  ]
}
