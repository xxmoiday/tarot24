PORT=3210

# Khoá dùng chung giữa web và backend; chưa đặt thì backend chặn hết
API_KEY=

# Chỉ những origin này được gọi từ trình duyệt; để trống là chặn hết
CORS_ORIGINS=https://tarrot24.online,https://www.tarrot24.online

DATABASE_URL=postgres://user:pass@localhost:5432/tarot24
DATABASE_POOL_MAX=5

LLM_PROVIDERS=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# Số lượt gọi tối đa mỗi IP mỗi giờ
RATE_PER_HOUR=30
