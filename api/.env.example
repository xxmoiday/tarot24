PORT=3210

# Khoá dùng chung giữa web và backend; chưa đặt thì backend chặn hết
API_KEY=

# Ứng dụng khác gọi vào, mỗi bên một mục "ten:khoa:tran_luot_moi_ngay", cách
# nhau bằng dấu phẩy. Trần riêng là cái nắp để một bên hỏng — retry loạn, khoá
# bị lộ — không nuốt hết LLM_CALLS_PER_DAY ở dưới; bỏ phần trần đi thì bên đó
# chỉ chịu trần tổng. Web cố tình không có trần riêng vì nó là sản phẩm chính.
# Sinh khoá: openssl rand -base64url 24
# API_KEYS=troly:khoa-cua-ho:250
API_KEYS=

# Chỉ những origin này được gọi từ trình duyệt; để trống là chặn hết
CORS_ORIGINS=https://tarot24.online,https://www.tarot24.online

# Gốc của web, dùng để dựng đường dẫn ảnh lá trong /api/cards
WEB_BASE_URL=https://www.tarot24.online

DATABASE_URL=postgres://user:pass@localhost:5432/tarot24
DATABASE_POOL_MAX=5

LLM_PROVIDERS=deepseek
DEEPSEEK_API_KEY=
# deepseek-flash hoặc deepseek-v4-pro. Pro đắt gấp 4,4 lần ở cả token vào lẫn
# ra. Đừng để tên cũ không có trong tài liệu: không biết nó tính theo cột nào.
DEEPSEEK_MODEL=deepseek-flash

# Chỗ chừa cho phần suy luận trong max_tokens. Model biết nghĩ ăn chung trần
# với phần viết; chừa thiếu thì bài trả về rỗng. Trần rộng không tốn thêm tiền
# nếu không dùng tới.
# Đo trên prompt thật: một lá nghĩ 3.214–4.662, ba lá 5.114–8.431, năm lá 8.104.
# 2000 làm hỏng phần lớn lượt gọi; đừng hạ xuống dưới 10000.
LLM_REASONING_TOKENS=12000

# Trần thời gian một lượt gọi mô hình. Nghĩ nhiều thì lâu: trải mười lá đo được
# 40–52 giây, nên 60000 là sát mép, chậm hơn chút là đứt giữa chừng.
LLM_TIMEOUT_MS=120000

# Trần tổng số lượt gọi mô hình mỗi ngày, tính cả lượt gọi lại để sửa bài.
# Mọi giới hạn khác đếm theo IP mà IP thì đổi được; đây là chỗ duy nhất chốt
# được tiền phải trả trong ngày. Đặt 0 để tắt.
LLM_CALLS_PER_DAY=1000
# Sổ đếm ghi ra đây để pm2 restart lúc triển khai không xoá số của hôm đó.
# Phải nằm ngoài thư mục mã nguồn vì rsync lúc deploy chạy kèm --delete.
LLM_BUDGET_FILE=/var/lib/tarot24/llm-budget.json

# Số lượt gọi tối đa mỗi IP mỗi giờ
RATE_PER_HOUR=30
