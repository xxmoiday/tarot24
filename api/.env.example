PORT=3210

# Khoá dùng chung giữa web và backend; chưa đặt thì backend chặn hết
API_KEY=

# Chỉ những origin này được gọi từ trình duyệt; để trống là chặn hết
CORS_ORIGINS=https://tarot24.online,https://www.tarot24.online

DATABASE_URL=postgres://user:pass@localhost:5432/tarot24
DATABASE_POOL_MAX=5

LLM_PROVIDERS=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# Trần tổng số lượt gọi mô hình mỗi ngày, tính cả lượt gọi lại để sửa bài.
# Mọi giới hạn khác đếm theo IP mà IP thì đổi được; đây là chỗ duy nhất chốt
# được tiền phải trả trong ngày. Đặt 0 để tắt.
LLM_CALLS_PER_DAY=1000
# Sổ đếm ghi ra đây để pm2 restart lúc triển khai không xoá số của hôm đó.
# Phải nằm ngoài thư mục mã nguồn vì rsync lúc deploy chạy kèm --delete.
LLM_BUDGET_FILE=/var/lib/tarot24/llm-budget.json

# Số lượt gọi tối đa mỗi IP mỗi giờ
RATE_PER_HOUR=30
