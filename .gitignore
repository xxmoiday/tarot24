# .gitignore gốc của monorepo tarot24.
# api/ và web/ vẫn giữ .gitignore riêng; file này lo phần dùng chung
# và bịt các lỗ hổng mà 2 file kia bỏ sót.

# Dependencies
node_modules/

# Cache build của TypeScript
*.tsbuildinfo

# Env & secrets (giữ lại file mẫu)
.env
.env.*
!.env.example

# Khoá, chứng chỉ
*.pem
*.key
*.p12

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test coverage
coverage/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

# ─────────── Dữ liệu KB sinh ra, xem web/resources/kb/README.md ───────────
# Người sửa ở: web/resources/kb/{cards,spreads}/*.yaml
#              web/resources/kb/prompts/system_luan_bai.md
# Bản JSON duy nhất được commit: web/data/*.source.json
# Mọi thứ dưới đây đều sinh lại được bằng `npm run kb:sync` (web)
# hoặc `npm run sync:kb` (api), nên không commit.
/web/resources/kb/build/
/web/data/system_luan_bai.md
/api/data/

# CỐ Ý KHÔNG ignore ở đây:
#   build/, dist/, .next/, out/ dạng không neo -> api/.gitignore và
#     web/.gitignore đã xử lý đúng phạm vi của chúng rồi.
#   web/data/*.source.json -> bản JSON duy nhất được commit, để app build
#     được mà không cần chạy pipeline Python.
#   .claude/ -> api/.claude/skills/ đang được track có chủ đích.
